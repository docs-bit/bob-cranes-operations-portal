# Required local server configuration
# Use a MySQL-compatible database created for local development.
DATABASE_URL=mysql://bob_portal:change-me@127.0.0.1:3306/bob_cranes_portal

# Use a long, randomly generated value. Do not reuse this example value.
JWT_SECRET=replace-with-a-long-random-development-secret

# Server runtime
NODE_ENV=development
PORT=3000

# Optional sample-data seeder configuration. Never use a production password here.
SAMPLE_DB_PASSWORD=replace-with-a-local-demo-password

# Optional Umami analytics. Set both variables together when analytics is enabled.
# VITE_ANALYTICS_ENDPOINT=https://analytics.example.com
# VITE_ANALYTICS_WEBSITE_ID=replace-with-umami-website-id

# Optional platform integrations. Configure only when the corresponding integration is enabled.
# VITE_APP_ID=
# OAUTH_SERVER_URL=
# OWNER_OPEN_ID=
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=
