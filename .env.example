# BOB Cranes Operations Portal - Environment Variables
# Copy this file to .env and fill in the values

# Required: MySQL/TiDB connection string
DATABASE_URL=mysql://user:password@localhost:3306/bob_cranes

# Required: Secret for JWT token signing (min 32 chars)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-secure-random-secret-here

# Optional: Application ID for Vite
VITE_APP_ID=bob-cranes-portal

# Optional: Owner OpenID for admin access
OWNER_OPEN_ID=

# Optional: OAuth server URL
OAUTH_SERVER_URL=

# Optional: Built-in Forge API (for 3D model viewing)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
